# Add these settings to the existing VPS .env. Never commit real credentials.
OPS_TELEGRAM_TOKEN=
OPS_ADMIN_IDS=
OPS_INTERNAL_TOKEN=
OPS_DATABASE_URL=
OPS_GITHUB_TOKEN=

# Persistent paths outside /opt/ocr-platform Git checkout; create and chown to UID 10001.
OPS_STATE_HOST_DIR=/var/lib/ocr-ops/state
OPS_PULSE_CODEX_HOME_HOST=/var/lib/ocr-ops/codex-pulse
OPS_FIXER_CODEX_HOME_HOST=/var/lib/ocr-ops/codex-fixer

# Rotated AmneziaWG profile, root-owned mode 0600, outside the Git checkout.
OPS_AWG_CONFIG_HOST=/var/lib/ocr-ops/vpn/awg0.conf

OPS_GITHUB_REPO=suer-tech/OCR_document_reader
OPS_GITHUB_BASE_BRANCH=main
OPS_HH_GITHUB_REPO=suer-tech/ai-candidate-screening
OPS_HH_GITHUB_BASE_BRANCH=production
OPS_ENABLE_FIXER=true
OPS_ENABLE_RELEASE=true
OPS_TIMEZONE=Asia/Yekaterinburg
OPS_DAILY_SUMMARY_ENABLED=true
OPS_DAILY_SUMMARY_HOUR=19
OPS_DAILY_SUMMARY_MINUTE=0
OPS_HR_MONITOR_ENABLED=true
OPS_HR_MONITOR_HOST=
OPS_HR_MONITOR_USER=hh-ops-monitor
OPS_HR_MONITOR_URL=
