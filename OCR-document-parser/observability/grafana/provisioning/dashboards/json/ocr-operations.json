{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (method, route) (rate(ocr_http_requests_total[5m]))", "legendFormat": "{{method}} {{route}}", "refId": "A"}],
      "title": "Request rate by endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(ocr_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(ocr_http_requests_total[5m])), 1e-9)", "refId": "A"}],
      "title": "HTTP 5xx error rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(increase(ocr_http_requests_total[24h]))", "refId": "A"}],
      "title": "Requests in 24h",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(ocr_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{method}} {{route}}", "refId": "A"}],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "id": 5,
      "targets": [{"expr": "sum(ocr_http_requests_in_progress)", "refId": "A"}],
      "title": "Requests in progress",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "id": 6,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(ocr_http_request_size_bytes_bucket[1h])))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "Request body size p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 7,
      "targets": [
        {"expr": "rabbitmq_queue_messages_ready", "legendFormat": "ready", "refId": "A"},
        {"expr": "rabbitmq_queue_messages_unacked", "legendFormat": "processing", "refId": "B"}
      ],
      "title": "RabbitMQ queue depth",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "id": 8,
      "targets": [{"expr": "rabbitmq_queue_consumers", "refId": "A"}],
      "title": "RabbitMQ consumers",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "id": 9,
      "targets": [{"expr": "process_resident_memory_bytes{job=~\"ocr-api|ocr-worker\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "OCR process memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 10,
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"ocr-.*|ocr-document-parser-worker-1\"}[5m]))", "legendFormat": "{{name}}", "refId": "A"}],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 11,
      "targets": [{"expr": "container_memory_working_set_bytes{name=~\"ocr-.*|ocr-document-parser-worker-1\"}", "legendFormat": "{{name}}", "refId": "A"}],
      "title": "Container memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32},
      "id": 12,
      "targets": [{"expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "refId": "A"}],
      "title": "Docker host CPU",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32},
      "id": 13,
      "targets": [{"expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes", "refId": "A"}],
      "title": "Docker host memory",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32},
      "id": 14,
      "targets": [{"expr": "max(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"})", "refId": "A"}],
      "title": "Docker host disk available",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 40},
      "id": 15,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "{job=\"ocr-app\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent application logs",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["ocr", "operations", "prometheus", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "OCR Operations",
  "uid": "ocr-operations",
  "version": 1
}
